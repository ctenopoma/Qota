// 旧 Tauri 版の src/index.css と tailwind.config.js のデザイントークンを移したもの。
// oklch() は Slint に無いので、同じ値を sRGB の hex に変換して持つ。

export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #0c0d0f : #fbfcfd;
    out property <color> panel: dark ? #121417 : #f4f5f7;
    out property <color> panel2: dark ? #191b1d : #e9ebee;
    out property <color> ink: dark ? #f0f2f5 : #151618;
    out property <color> mute: dark ? #95989f : #4a4d53;
    out property <color> faint: dark ? #5a5e63 : #83868c;
    out property <color> border: dark ? #27292d : #d5d7db;
    out property <color> accent: dark ? #6ed274 : #1c882d;
    out property <color> high: dark ? #ff7e76 : #c53637;
    out property <color> med: dark ? #eca851 : #b77610;

    // tailwind の text-2xs / text-xs / text-sm / text-base
    out property <length> fs-2xs: 11px;
    out property <length> fs-xs: 12px;
    out property <length> fs-sm: 14px;
    out property <length> fs-base: 16px;
    out property <string> sans: "Segoe UI";
    out property <string> mono: "Consolas";
    out property <string> symbol: "Segoe UI Symbol";
    out property <length> row-pad: 7px;

    // TaskRow.tsx の priColor / priLabel
    public pure function priority-color(p: int) -> color {
        p == 1 ? high : p == 2 ? med : faint
    }
    public pure function priority-label(p: int) -> string {
        p == 1 ? "H" : p == 2 ? "M" : p == 3 ? "L" : "–"
    }
}

import { CalendarDay } from "types.slint";

// Rust 側に実装を持つ小さなヘルパー。
export global Bridge {
    in property <int> today-year: 2026;
    in property <int> today-month: 1;
    in property <int> today-day: 1;

    // ドラッグ&ドロップの payload (data-transfer) は Slint 側では作れない・読めないので Rust に任せる
    pure callback payload(id: string) -> data-transfer;
    pure callback payload-text(data: data-transfer) -> string;

    // 操作の取り消し・やり直しと、画面の戻る・進む。どの部品からでも呼べるようにここに置く
    callback undo();
    callback redo();
    callback nav-back();
    callback nav-forward();

    // year 年 month 月を含む週を並べたマス（7 の倍数個）
    pure callback month-days(year: int, month: int, monday-first: bool) -> [CalendarDay];
}
