// 旧 Tauri 版の src/components/Sidebar.tsx の移植（インサイトは外した）
import { ScrollView } from "std-widgets.slint";
import { Theme, Bridge } from "theme.slint";
import { Label, TextButton, Input, HLine } from "widgets.slint";
import { NavProject } from "types.slint";

component NavButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <color> dot: transparent;
    callback clicked();

    border-radius: 4px;
    background: root.active ? Theme.panel2 : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 8px;
        if root.dot != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.dot;
            }
        }
        Label {
            horizontal-stretch: 1;
            text: root.text;
            text-color: root.active || ta.has-hover ? Theme.ink : Theme.mute;
            font-size: Theme.fs-2xs;
            mono: true;
            letter-spacing: 0.3px;
            line-height: 20px;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> text;
    in property <int> badge;
    callback clicked();

    HorizontalLayout {
        TextButton {
            text: root.text;
            bordered: true;
            clicked => {
                root.clicked();
            }
        }
    }

    if root.badge > 0: Rectangle {
        x: parent.width - 8px;
        y: -4px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.high;
        Text {
            text: root.badge;
            color: Theme.bg;
            font-size: 9px;
            font-family: Theme.mono;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <string> view;
    in property <string> project-id;
    in property <[NavProject]> projects;
    in property <int> overdue-count;
    in property <bool> open;

    callback navigate(view: string, project-id: string);
    callback command();
    callback search();
    callback notif();
    callback toggle-open();
    callback add-project(name: string);
    // プロジェクトのドラッグ&ドロップ。before はその前に入れるプロジェクト（空なら末尾）
    callback move-project(payload: string, before: string);

    property <int> project-slot: -1;

    property <bool> adding-project;

    background: Theme.panel;
    clip: true;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        if root.open: sbv := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: max(self.visible-height, top.preferred-height);

            top := VerticalLayout {
                width: sbv.visible-width;
                alignment: start;
                padding: 12px;
                spacing: 12px;

                HorizontalLayout {
                    Label {
                        horizontal-stretch: 1;
                        text: "QOTA";
                        text-color: Theme.faint;
                        font-size: Theme.fs-2xs;
                        mono: true;
                        letter-spacing: 1.1px;
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        IconButton {
                            text: "検索";
                            clicked => {
                                root.search();
                            }
                        }

                        IconButton {
                            text: "通知";
                            badge: root.overdue-count;
                            clicked => {
                                root.notif();
                            }
                        }
                    }
                }

                cmd := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.command();
                    }
                    Rectangle {
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            Label {
                                horizontal-stretch: 1;
                                text: "コマンド…";
                                text-color: cmd.has-hover ? Theme.ink : Theme.mute;
                                font-size: Theme.fs-2xs;
                            }

                            Label {
                                text: "Ctrl K";
                                text-color: cmd.has-hover ? Theme.ink : Theme.mute;
                                font-size: Theme.fs-2xs;
                                mono: true;
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    NavButton {
                        text: "今日";
                        active: root.view == "today";
                        clicked => {
                            root.navigate("today", "");
                        }
                    }

                    NavButton {
                        text: "今後";
                        active: root.view == "upcoming";
                        clicked => {
                            root.navigate("upcoming", "");
                        }
                    }

                    NavButton {
                        text: "カレンダー";
                        active: root.view == "calendar";
                        clicked => {
                            root.navigate("calendar", "");
                        }
                    }
                }

                VerticalLayout {
                    padding-top: 8px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 8px;
                        Label {
                            horizontal-stretch: 1;
                            text: "プロジェクト";
                            text-color: Theme.faint;
                            font-size: Theme.fs-2xs;
                            mono: true;
                            letter-spacing: 1.1px;
                        }

                        TextButton {
                            text: "＋";
                            clicked => {
                                root.adding-project = true;
                            }
                        }

                        TextButton {
                            text: "一覧";
                            clicked => {
                                root.navigate("projects", "");
                            }
                        }
                    }

                    if root.adding-project: Input {
                        bordered: true;
                        font-size: Theme.fs-2xs;
                        placeholder: "プロジェクト名...";
                        init => {
                            self.focus();
                        }
                        accepted(text) => {
                            root.add-project(text);
                            root.adding-project = false;
                        }
                        focus-out(text) => {
                            if text == "" {
                                root.adding-project = false;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        for p[i] in root.projects: Rectangle {
                            height: 28px;
                            pdrop := DropArea {
                                can-drop(event) => {
                                    root.project-slot = event.position.y < self.height / 2 ? i : i + 1;
                                    event.proposed-action
                                }
                                dropped(event) => {
                                    root.move-project(Bridge.payload-text(event.data),
                                        root.project-slot < root.projects.length ? root.projects[root.project-slot].id : "");
                                    root.project-slot = -1;
                                    event.proposed-action
                                }

                                DragArea {
                                    allow-move: true;
                                    // サブタスクのドロップ先と取り違えないよう、種類を付けて渡す
                                    data: Bridge.payload("project:" + p.id);
                                    drag-finished(action) => {
                                        root.project-slot = -1;
                                    }
                                    NavButton {
                                        width: 100%;
                                        height: 100%;
                                        text: p.name;
                                        dot: p.color;
                                        active: root.view == "project" && root.project-id == p.id;
                                        clicked => {
                                            root.navigate("project", p.id);
                                        }
                                    }
                                }
                            }

                            // 挿入位置のインジケータ
                            Rectangle {
                                y: -1px;
                                height: 2px;
                                background: Theme.accent;
                                visible: pdrop.has-drag && root.project-slot == i;
                            }

                            Rectangle {
                                y: parent.height - 1px;
                                height: 2px;
                                background: Theme.accent;
                                visible: pdrop.has-drag && root.project-slot == i + 1;
                            }
                        }
                    }
                }
            }
        }

        if !root.open: VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding: 12px;
            spacing: 4px;
            IconButton {
                text: "/";
                clicked => {
                    root.search();
                }
            }

            IconButton {
                text: "!";
                badge: root.overdue-count;
                clicked => {
                    root.notif();
                }
            }
        }

        HLine { }

        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            if root.open: VerticalLayout {
                spacing: 2px;
                NavButton {
                    text: "タグ";
                    active: root.view == "tags";
                    clicked => {
                        root.navigate("tags", "");
                    }
                }

                NavButton {
                    text: "設定";
                    active: root.view == "settings";
                    clicked => {
                        root.navigate("settings", "");
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                TextButton {
                    text: root.open ? "◀" : "▶";
                    family: Theme.symbol;
                    bordered: true;
                    clicked => {
                        root.toggle-open();
                    }
                }
            }
        }
    }
}
