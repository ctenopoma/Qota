// Rust 側 (src/view.rs) で AppData から組み立てて渡す表示用の型。
// priority は 0 = なし, 1 = high, 2 = medium, 3 = low。

export struct SubtaskItem {
    id: string,
    title: string,
    done: bool,
}

export struct TaskItem {
    id: string,
    title: string,
    done: bool,
    priority: int,
    due-label: string,
    overdue: bool,
    due-year: int,
    due-month: int,
    due-day: int,
    project-name: string,
    project-color: color,
    tags: [string],
    repeating: bool,
    sub-done: int,
    sub-total: int,
    subtasks: [SubtaskItem],
    // サブタスクの展開状態。行が作り直されても消えないよう Rust 側で持つ
    expanded: bool,
}

export struct NavProject {
    id: string,
    name: string,
    color: color,
}

export struct TagChip {
    id: string,
    name: string,
    on: bool,
}

export struct TaskDetailData {
    id: string,
    title: string,
    notes: string,
    done: bool,
    priority: int,
    due-label: string,
    due-year: int,
    due-month: int,
    due-day: int,
    project-index: int,
    repeating: bool,
    interval-index: int,
    recurrence-end-label: string,
    recurrence-end-year: int,
    recurrence-end-month: int,
    recurrence-end-day: int,
}

// 日付ピッカーの 1 マス。前後の月の日も並べるので in-month で区別する（今日かどうかは Bridge.today-* と比べる）
export struct CalendarDay {
    year: int,
    month: int,
    day: int,
    in-month: bool,
}

export struct Command {
    label: string,
    sub: string,
    view: string,
    project-id: string,
}

// 今後（カンバン）・プロジェクト一覧・タグの列
export struct Column {
    id: string,
    title: string,
    // 見出しの右に出す件数や「完了/全体」
    sub: string,
    color: color,
    has-color: bool,
    // プロジェクトの色の元の文字列（編集で今の色を選んだ状態にするため）
    color-key: string,
    tasks: [TaskItem],
}

// 今日のタイムチャートの 1 行（今日のタスク 1 件）。棒が無ければ block-id は空
export struct PlanRowItem {
    task-id: string,
    title: string,
    done: bool,
    block-id: string,
    // 時間軸の先頭から数えた 15 分の枠の番号と長さ
    start-slot: int,
    len-slots: int,
    // 実績の棒。a-kind: 0 なし / 1 進行中（予定どおり、いまの時刻まで）/ 2 予定どおり（記録なし）/ 3 記録あり。
    // a-start と a-len は枠の数（15 分 = 1。小数）
    a-kind: int,
    a-start: float,
    a-len: float,
}

// 振り返りの 1 行（タスク 1 件。繰り返しは同じ系列をまとめて 1 行）
export struct ReviewRow {
    // 詳細を開くタスク。消したタスクは空
    task-id: string,
    title: string,
    // 期間の中で完了した
    done: bool,
    deleted: bool,
    // 完了の欄（日の振り返りでは時刻、週・月では日付、2 回以上なら回数）
    done-label: string,
    // 計画・実績の時間（「1:30」。計画が無ければ空。実績は進行中なら「…」付き、未着手なら「–」）
    plan: string,
    actual: string,
    // 実績 − 計画。計画が終わっていなければ空
    diff: string,
    // 1 計画より長い / -1 短い / 0 同じか比べられない
    diff-sign: int,
}

// 振り返りのプロジェクトごとのまとまり
export struct ReviewGroup {
    name: string,
    color: color,
    has-color: bool,
    // 見出しの右（「完了 3 件 ・ 実績 2:30」）
    sub: string,
    rows: [ReviewRow],
}

// 振り返りの期間全体の合計
export struct ReviewSummary {
    done: int,
    plan: string,
    actual: string,
    diff: string,
    diff-sign: int,
    // 差の下の注記（進行中・未着手の計画を差に入れていないとき）
    diff-note: string,
}

// カレンダーの 1 マス。day == 0 は月初めの前の空白
export struct CalCell {
    year: int,
    month: int,
    day: int,
    today: bool,
    // 先頭 2 件だけ。残りの件数は more
    tasks: [TaskItem],
    more: int,
}
