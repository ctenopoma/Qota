// 旧 Tauri 版の src/components/TaskTable.tsx + TaskRow.tsx の移植（時間計測の UI は外した）
import { ScrollView } from "std-widgets.slint";
import { Theme, Bridge } from "theme.slint";
import { Check, Label, TextButton, Input, DateButton, HLine, Select } from "widgets.slint";
import { TaskItem } from "types.slint";

component Badge inherits Rectangle {
    in property <string> text;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    max-width: 120px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;
        Label {
            text: root.text;
            text-color: Theme.mute;
            font-size: Theme.fs-2xs;
            mono: true;
            line-height: 20px;
        }
    }
}

component PriorityButton inherits Rectangle {
    in property <int> priority;
    callback picked(p: int);

    width: 20px;
    height: 18px;

    Label {
        width: 100%;
        height: 100%;
        text: Theme.priority-label(root.priority);
        text-color: Theme.priority-color(root.priority);
        font-size: Theme.fs-2xs;
        mono: true;
        align: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 36px;
        height: 4 * 20px + 6px;

        Rectangle {
            background: Theme.panel2;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000066;

            VerticalLayout {
                padding: 2px;
                for p in [1, 2, 3, 0]: Rectangle {
                    height: 20px;
                    border-radius: 2px;
                    background: pta.has-hover ? Theme.panel : transparent;
                    Label {
                        x: 8px;
                        width: parent.width - 16px;
                        height: 100%;
                        text: Theme.priority-label(p);
                        text-color: Theme.priority-color(p);
                        font-size: Theme.fs-2xs;
                        mono: true;
                    }

                    pta := TouchArea {
                        clicked => {
                            root.picked(p);
                        }
                    }
                }
            }
        }
    }
}

export component TaskRow inherits Rectangle {
    in property <TaskItem> task;
    // 狭いウィンドウ（mini モード）では、プロジェクト・タグのバッジを隠してタイトルに幅を回す
    in property <bool> compact;
    callback open(id: string);
    callback toggle(id: string);
    callback toggle-expanded(id: string);
    callback set-priority(id: string, p: int);
    callback set-due(id: string, y: int, m: int, d: int);
    callback clear-due(id: string);
    callback duplicate(id: string);
    callback delete(id: string);
    callback toggle-subtask(task-id: string, subtask-id: string);

    // 一覧の並びが変わって、マウスの下の行に別のタスクが入ったとき
    changed task => {
        if hover.has-hover {
            Bridge.hover-task = root.task.id;
        }
    }

    VerticalLayout {
        hover := TouchArea {
            changed has-hover => {
                if self.has-hover {
                    Bridge.hover-task = root.task.id;
                } else if Bridge.hover-task == root.task.id {
                    Bridge.hover-task = "";
                }
            }
            Rectangle {
                background: hover.has-hover ? Theme.panel2 : transparent;
            }

            // grid-cols-[24px_24px_1fr_auto_64px_24px] gap-2 px-6
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: Theme.row-pad;
                padding-bottom: Theme.row-pad;
                spacing: 8px;

                Rectangle {
                    width: 24px;
                    Check {
                        x: 0;
                        checked: root.task.done;
                        toggled => {
                            root.toggle(root.task.id);
                        }
                    }
                }

                Rectangle {
                    width: 24px;
                    PriorityButton {
                        x: 0;
                        priority: root.task.priority;
                        picked(p) => {
                            root.set-priority(root.task.id, p);
                        }
                    }
                }

                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: start;

                    title := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open(root.task.id);
                        }
                        HorizontalLayout {
                            Label {
                                text: root.task.title;
                                strike: root.task.done;
                                underline: title.has-hover;
                                text-color: root.task.done ? Theme.mute : Theme.ink;
                            }
                        }
                    }

                    if root.task.sub-total > 0: TextButton {
                        text: (root.task.expanded ? "▼ " : "▶ ") + root.task.sub-done + "/" + root.task.sub-total;
                        family: Theme.symbol;
                        text-color: Theme.faint;
                        clicked => {
                            root.toggle-expanded(root.task.id);
                        }
                    }
                }

                if !root.compact: HorizontalLayout {
                    // 間隔は各要素の左余白で取る（2 個を超えて隠したタグが間隔だけ残さないように）
                    spacing: 0px;
                    alignment: end;
                    if root.task.repeating: HorizontalLayout {
                        padding-left: 4px;
                        Badge {
                            text: "🔁";
                        }
                    }
                    if root.task.project-name != "": HorizontalLayout {
                        padding-left: 4px;
                        Badge {
                            text: root.task.project-name;
                        }
                    }
                    for tag[i] in root.task.tags: Label {
                        visible: i < 2;
                        width: i < 2 ? self.preferred-width : 0px;
                        text: "#" + tag + " ";
                        text-color: Theme.faint;
                        font-size: Theme.fs-2xs;
                        mono: true;
                    }
                    if root.task.tags.length > 2: Label {
                        text: "+" + (root.task.tags.length - 2);
                        text-color: Theme.faint;
                        font-size: Theme.fs-2xs;
                        mono: true;
                    }
                }

                DateButton {
                    width: 64px;
                    label: root.task.due-label == "" ? "–" : root.task.due-label;
                    text-color: root.task.overdue && !root.task.done ? Theme.high : Theme.mute;
                    align: right;
                    year: root.task.due-year;
                    month: root.task.due-month;
                    day: root.task.due-day;
                    picked(y, m, d) => {
                        root.set-due(root.task.id, y, m, d);
                    }
                    cleared => {
                        root.clear-due(root.task.id);
                    }
                }

                HorizontalLayout {
                    width: 32px;
                    spacing: 8px;
                    alignment: end;
                    TextButton {
                        visible: hover.has-hover;
                        text: "⧉";
                        family: Theme.symbol;
                        text-color: Theme.faint;
                        clicked => {
                            root.duplicate(root.task.id);
                        }
                    }
                    TextButton {
                        visible: hover.has-hover;
                        text: "×";
                        text-color: Theme.faint;
                        hover-color: Theme.high;
                        clicked => {
                            root.delete(root.task.id);
                        }
                    }
                }
            }
        }

        HLine { }

        if root.task.expanded && root.task.sub-total > 0: VerticalLayout {
            Rectangle {
                background: Theme.panel.with-alpha(0.5);
                VerticalLayout {
                    padding-left: 80px;
                    padding-right: 24px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    for s in root.task.subtasks: HorizontalLayout {
                        spacing: 8px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        VerticalLayout {
                            alignment: center;
                            Check {
                                size: 12px;
                                checked: s.done;
                                toggled => {
                                    root.toggle-subtask(root.task.id, s.id);
                                }
                            }
                        }

                        Label {
                            horizontal-stretch: 1;
                            text: s.title;
                            strike: s.done;
                            text-color: s.done ? Theme.mute : Theme.faint;
                        }
                    }
                }
            }

            HLine { }
        }
    }
}

export component TaskTable inherits Rectangle {
    in property <bool> compact;
    in property <string> title;
    in property <string> subtitle;
    in property <[TaskItem]> active;
    in property <[TaskItem]> done;
    in-out property <bool> archive-open;
    // 見出しの右に並び順のセレクトを出す（今日の一覧だけ）。並びは src/view.rs の SORT_KEYS と同じ順
    in property <bool> sortable;
    in-out property <int> sort-index;
    callback sort-changed();

    callback add-task(title: string);
    callback open(id: string);
    callback toggle(id: string);
    callback toggle-expanded(id: string);
    callback set-priority(id: string, p: int);
    callback set-due(id: string, y: int, m: int, d: int);
    callback clear-due(id: string);
    callback duplicate(id: string);
    callback delete(id: string);
    callback toggle-subtask(task-id: string, subtask-id: string);

    VerticalLayout {
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 12px;
            Label {
                text: root.title;
                font-size: Theme.fs-base;
                font-weight: 600;
            }

            if root.subtitle != "": Label {
                text: root.subtitle;
                text-color: Theme.mute;
                font-size: Theme.fs-2xs;
                mono: true;
            }
            Rectangle {
                horizontal-stretch: 1;
            }

            if root.sortable: Select {
                width: 112px;
                options: ["期日順", "優先度順", "プロジェクト順", "追加順"];
                current-index: root.sort-index;
                selected(i) => {
                    root.sort-index = i;
                    root.sort-changed();
                }
            }

            Label {
                text: root.active.length + " 件";
                text-color: Theme.mute;
                font-size: Theme.fs-2xs;
                mono: true;
            }
        }

        HLine { }

        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            padding-bottom: 8px;
            composer := Input {
                placeholder: "+ 新しいタスク (Enter で追加)";
                task-paste: true;
                accepted(text) => {
                    root.add-task(text);
                    self.text = "";
                }
            }
        }

        HLine { }

        sv := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: max(self.visible-height, list.preferred-height);

            list := VerticalLayout {
                width: sv.visible-width;
                alignment: start;

                if root.active.length == 0 && root.done.length == 0: Rectangle {
                    height: 120px;
                    Label {
                        width: 100%;
                        height: 100%;
                        text: "タスクなし";
                        text-color: Theme.faint;
                        font-size: Theme.fs-2xs;
                        mono: true;
                        align: center;
                    }
                }

                for t in root.active: TaskRow {
                    compact: root.compact;
                    task: t;
                    open(id) => { root.open(id); }
                    toggle(id) => { root.toggle(id); }
                    toggle-expanded(id) => { root.toggle-expanded(id); }
                    set-priority(id, p) => { root.set-priority(id, p); }
                    set-due(id, y, m, d) => { root.set-due(id, y, m, d); }
                    clear-due(id) => { root.clear-due(id); }
                    duplicate(id) => { root.duplicate(id); }
                    delete(id) => { root.delete(id); }
                    toggle-subtask(tid, sid) => { root.toggle-subtask(tid, sid); }
                }

                if root.done.length > 0: VerticalLayout {
                    arch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.archive-open = !root.archive-open;
                        }
                        HorizontalLayout {
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            Label {
                                text: (root.archive-open ? "▼" : "▶") + "  完了済み " + root.done.length;
                                family: Theme.symbol;
                                text-color: arch.has-hover ? Theme.ink : Theme.mute;
                                font-size: Theme.fs-2xs;
                                mono: true;
                            }
                        }
                    }

                    if root.archive-open: VerticalLayout {
                        for t in root.done: TaskRow {
                            opacity: 0.6;
                            compact: root.compact;
                            task: t;
                            open(id) => { root.open(id); }
                            toggle(id) => { root.toggle(id); }
                            toggle-expanded(id) => { root.toggle-expanded(id); }
                            set-priority(id, p) => { root.set-priority(id, p); }
                            set-due(id, y, m, d) => { root.set-due(id, y, m, d); }
                    clear-due(id) => { root.clear-due(id); }
                            duplicate(id) => { root.duplicate(id); }
                            delete(id) => { root.delete(id); }
                            toggle-subtask(tid, sid) => { root.toggle-subtask(tid, sid); }
                        }
                    }
                }
            }
        }
    }
}
