// 旧 Tauri 版 (コミット 8d92187 まで) の src/App.tsx の移植。ルーティング・オーバーレイ・グローバルショートカットを持つ。
import { Palette } from "std-widgets.slint";
import { Theme, Bridge } from "theme.slint";
import { Label, TextButton } from "widgets.slint";
import { TaskItem, SubtaskItem, NavProject, TagChip, TaskDetailData, Command, CalendarDay, Column, CalCell, PlanRowItem, ReviewRow, ReviewGroup, ReviewSummary } from "types.slint";
import { Sidebar } from "sidebar.slint";
import { TaskTable } from "task-table.slint";
import { TimeChart } from "timechart.slint";
import { TaskDetail } from "task-detail.slint";
import { SettingsPage, CommandPalette, ConfirmDialog } from "pages.slint";
import { UpcomingView, ProjectsView, TagsView, CalendarView, DayDialog, SearchPanel, NotifPanel } from "views.slint";
import { ReviewView } from "review.slint";

export { Theme, Bridge, TaskItem, SubtaskItem, NavProject, TagChip, TaskDetailData, Command, CalendarDay, Column, CalCell, PlanRowItem, ReviewRow, ReviewGroup, ReviewSummary }

export component AppWindow inherits Window {
    title: "Qota";
    icon: @image-url("../assets/128x128.png");
    preferred-width: 1280px;
    preferred-height: 820px;
    // 幅 720px 未満は mini モード（サイドバーを上部バーとドロワーに替える）
    min-width: 360px;
    min-height: 420px;
    background: Theme.bg;
    default-font-family: Theme.sans;
    default-font-size: Theme.fs-sm;

    // ───── routing ─────
    in-out property <string> view: "today";
    in-out property <string> project-id;
    in-out property <bool> sidebar-open: true;
    // 幅から束縛で求めるとレイアウトの計算と循環するので、changed で更新する
    in-out property <bool> compact: false;
    changed width => {
        root.compact = root.width < 720px;
        // 広げてドロワーが消えたあと、また縮めたときに開いた状態で戻らないようにする
        if (!root.compact) {
            root.drawer-open = false;
        }
    }
    // mini モードでサイドバー（ドロワー）を開いているか
    in-out property <bool> drawer-open;
    // 初回の操作ヒントを閉じたか（閉じたら ui-state.json に残す）
    in-out property <bool> hint-dismissed;
    // 今日をタイムチャートで見ているか（ui-state.json に残す）
    in-out property <bool> today-chart;
    in property <[PlanRowItem]> plan-rows;
    in property <int> plan-unplaced-count;
    in property <int> chart-slots;
    in property <int> chart-start-hour;
    in property <float> chart-now-slot: -1;
    // 設定: タイムチャートの時間軸（時）
    in property <int> day-start-hour: 6;
    in property <int> day-end-hour: 24;
    callback set-day-range(start: int, end: int);
    callback plan-place(task-id: string, slot: int);
    callback plan-place-now(task-id: string);
    callback plan-arrange();
    callback plan-resize(id: string, len-slots: int);
    callback plan-move-by(id: string, delta-slots: int);
    callback plan-resize-by(id: string, delta-slots: int);
    callback plan-remove(id: string);
    callback actual-stop(task-id: string);
    callback actual-set(task-id: string, start-slot: float, end-slot: float);
    // キーボードで選んでいる一覧の行（active-tasks の何番目か。-1 なら無し）
    in-out property <int> list-cursor: -1;
    // Ctrl+N の要求（新規タスクの入力欄へ移る）
    in-out property <bool> compose-request;

    // ───── list ─────
    in property <string> list-title;
    in property <string> list-subtitle;
    in property <[TaskItem]> active-tasks;
    in property <[TaskItem]> done-tasks;
    in-out property <bool> archive-open;
    // 今日の一覧の並び順（src/view.rs の SORT_KEYS の位置）
    in-out property <int> today-sort;

    // ───── sidebar ─────
    in property <[NavProject]> projects;
    in property <int> overdue-count;

    // ───── detail ─────
    in-out property <bool> detail-open;
    // 繰り返しの 1 件を変えるとき、以降の回にも反映するか。詳細パネルの「変更の範囲」で切り替える
    in-out property <bool> series-following;
    in property <TaskDetailData> detail;
    in property <[SubtaskItem]> detail-subtasks;
    in property <[TagChip]> detail-tags;
    in property <[string]> project-options;

    // ───── palette / settings ─────
    in-out property <bool> palette-open;
    in property <[Command]> commands;
    in-out property <int> palette-index;
    // ───── toast ─────
    // 画面下部の通知。toast-action があればボタンを出す（「元に戻す」など）
    in property <string> toast-text;
    in property <string> toast-action;
    in property <bool> toast-error;
    in property <string> data-path;

    // ───── 今後・プロジェクト一覧・タグ（表示中の画面の列だけ入れる）─────
    in property <[Column]> columns;

    // ───── カレンダー ─────
    in property <string> cal-title;
    in property <bool> cal-monday-first;
    in property <[CalCell]> cal-cells;
    in-out property <bool> day-open;
    in property <string> day-title;
    in property <[TaskItem]> day-tasks;

    // ───── 検索・通知 ─────
    in-out property <bool> search-open;
    in property <[TaskItem]> search-results;
    in property <bool> search-has-query;
    in-out property <bool> notif-open;
    in property <[TaskItem]> notif-overdue;
    in property <[TaskItem]> notif-today;

    // ───── 振り返り ─────
    in property <string> review-period;
    // 期間の単位（src/review.rs の UNITS の位置）
    in property <int> review-unit;
    in property <string> review-now-label;
    in property <bool> review-at-now;
    in property <ReviewSummary> review-summary;
    in property <[ReviewGroup]> review-groups;
    callback review-set-unit(index: int);
    callback review-shift(delta: int);
    callback review-now();
    callback review-copy();
    callback review-export();

    // ───── confirm ─────
    in-out property <bool> confirm-open;
    in property <string> confirm-message;
    in property <string> confirm-ok-label;

    callback navigate(view: string, project-id: string);
    callback add-task(title: string);
    callback sort-changed();
    callback add-project(name: string);
    callback open-task(id: string);
    callback toggle-task(id: string);
    callback toggle-expanded(id: string);
    callback set-priority(id: string, p: int);
    callback set-due(id: string, y: int, m: int, d: int);
    callback set-due-in(id: string, days: int);
    callback move-task-to-column(payload: string, column: int);
    callback dismiss-hint();
    callback clear-due(id: string);
    callback duplicate-task(id: string);
    callback delete-task(id: string);
    callback toggle-subtask(task-id: string, subtask-id: string);
    callback update-title(id: string, title: string);
    callback update-notes(id: string, notes: string);
    callback toggle-status(id: string);
    callback set-project(id: string, index: int);
    callback set-repeating(id: string, on: bool);
    callback set-interval(id: string, index: int);
    callback set-recurrence-end(id: string, y: int, m: int, d: int);
    callback clear-recurrence-end(id: string);
    callback toggle-tag(id: string, tag-id: string);
    callback add-subtask(id: string, title: string);
    callback delete-subtask(id: string, subtask-id: string);
    callback rename-subtask(id: string, subtask-id: string, title: string);
    callback drop-subtask(id: string, subtask-id: string, slot: int);
    callback palette-query(q: string);
    callback palette-run(index: int);
    callback set-dark(dark: bool);
    callback export-json();
    callback import-json();
    callback reset-data();
    callback restore-backup();
    callback open-backups();
    in property <string> latest-backup;
    callback confirm-result(ok: bool);
    callback toast-action-clicked();
    callback draft-title(id: string, title: string);
    callback draft-notes(id: string, notes: string);
    callback draft-subtask(id: string, subtask-id: string, title: string);
    // 詳細パネルで入力中の内容を保存する。閉じる前に必ず呼ぶ
    callback commit-drafts();
    callback cal-shift(delta: int);
    callback cal-today();
    callback open-day(year: int, month: int, day: int);
    callback add-project-color(name: string, color: string);
    callback update-project(id: string, name: string, color: string);
    callback delete-project(id: string);
    // サイドバーのドラッグ&ドロップ。slot は表示中（アーカイブ以外）の並びでの挿入位置
    callback move-project(payload: string, before: string);
    callback add-tag(name: string);
    callback delete-tag(id: string);
    callback search-query(q: string);

    // Rust からも呼ぶ（マウスの戻るボタンで、開いているパネルを閉じる）
    public function close-overlays() {
        // パネルを消すと入力欄のフォーカスアウトが呼ばれないので、先に確定させる
        root.commit-drafts();
        root.palette-open = false;
        root.detail-open = false;
        root.search-open = false;
        root.notif-open = false;
        root.day-open = false;
        keys.focus();
    }

    // パネルやダイアログが開いているか（開いていれば、画面のキー操作はそちらに譲る）
    pure function overlay-open() -> bool {
        root.detail-open || root.palette-open || root.search-open || root.notif-open || root.day-open || root.confirm-open
    }

    // 一覧のキー操作（↑↓ Enter Space Delete）を受けてよい状態か
    pure function list-keys-on() -> bool {
        ((root.view == "today" && !root.today-chart) || root.view == "project") && !root.overlay-open()
    }

    // 一覧の行が減ったときに、選んでいる行が範囲を越えないようにする
    pure function cur() -> int {
        min(root.list-cursor, root.active-tasks.length - 1)
    }

    function focus-composer() {
        root.close-overlays();
        if (root.view != "today" && root.view != "project") {
            root.navigate("today", "");
        }
        root.compose-request = true;
    }

    function go-to(v: string) {
        root.close-overlays();
        root.navigate(v, "");
    }

    function open-search() {
        root.search-query("");
        root.search-open = true;
    }

    function open-palette() {
        root.palette-index = 0;
        root.palette-query("");
        root.palette-open = true;
    }

    // std-widgets (スクロールバー・日付ピッカー) の配色をテーマに合わせる
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed sidebar-open => {
        keys.focus();
    }

    forward-focus: keys;

    keys := FocusScope {
        KeyBinding {
            keys: @keys(Control + K);
            activated => {
                root.open-palette();
            }
        }

        KeyBinding {
            keys: @keys(Control + "/");
            activated => {
                root.open-search();
            }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                root.close-overlays();
            }
        }


        // ───── キーボードだけでの操作 ─────
        // 今日の一覧とタイムチャートを切り替える（今日以外にいれば今日へ移る）
        KeyBinding {
            keys: @keys(Control + T);
            enabled: !root.confirm-open;
            activated => {
                root.close-overlays();
                if (root.view != "today") {
                    root.navigate("today", "");
                    root.today-chart = true;
                } else {
                    root.today-chart = !root.today-chart;
                }
            }
        }

        KeyBinding {
            keys: @keys(Control + N);
            enabled: !root.confirm-open;
            activated => {
                root.focus-composer();
            }
        }

        KeyBinding {
            keys: @keys(Control + "1");
            enabled: !root.confirm-open;
            activated => { root.go-to("today"); }
        }

        KeyBinding {
            keys: @keys(Control + "2");
            enabled: !root.confirm-open;
            activated => { root.go-to("upcoming"); }
        }

        KeyBinding {
            keys: @keys(Control + "3");
            enabled: !root.confirm-open;
            activated => { root.go-to("calendar"); }
        }

        KeyBinding {
            keys: @keys(Control + "4");
            enabled: !root.confirm-open;
            activated => { root.go-to("projects"); }
        }

        KeyBinding {
            keys: @keys(Control + "5");
            enabled: !root.confirm-open;
            activated => { root.go-to("tags"); }
        }

        KeyBinding {
            keys: @keys(Control + "6");
            enabled: !root.confirm-open;
            activated => { root.go-to("settings"); }
        }

        KeyBinding {
            keys: @keys(Control + "7");
            enabled: !root.confirm-open;
            activated => { root.go-to("review"); }
        }

        // 振り返りの期間を前後へ
        KeyBinding {
            keys: @keys(LeftArrow);
            enabled: root.view == "review" && !root.overlay-open();
            activated => { root.review-shift(-1); }
        }

        KeyBinding {
            keys: @keys(RightArrow);
            enabled: root.view == "review" && !root.overlay-open();
            activated => { root.review-shift(1); }
        }

        // 一覧の行を選ぶ。入力欄や詳細パネルを開いているときは、そちらが先に受け取る
        KeyBinding {
            keys: @keys(UpArrow);
            enabled: root.list-keys-on() && root.active-tasks.length > 0;
            activated => {
                root.list-cursor = max(0, root.cur() - 1);
            }
        }

        KeyBinding {
            keys: @keys(DownArrow);
            enabled: root.list-keys-on() && root.active-tasks.length > 0;
            activated => {
                root.list-cursor = min(root.active-tasks.length - 1, root.cur() + 1);
            }
        }

        KeyBinding {
            keys: @keys(Home);
            enabled: root.list-keys-on() && root.active-tasks.length > 0;
            activated => {
                root.list-cursor = 0;
            }
        }

        KeyBinding {
            keys: @keys(End);
            enabled: root.list-keys-on() && root.active-tasks.length > 0;
            activated => {
                root.list-cursor = root.active-tasks.length - 1;
            }
        }

        KeyBinding {
            keys: @keys(Return);
            enabled: root.list-keys-on() && root.cur() >= 0;
            activated => {
                root.open-task(root.active-tasks[root.cur()].id);
            }
        }

        KeyBinding {
            keys: @keys(Space);
            enabled: root.list-keys-on() && root.cur() >= 0;
            activated => {
                root.toggle-task(root.active-tasks[root.cur()].id);
            }
        }

        KeyBinding {
            keys: @keys(Delete);
            enabled: root.list-keys-on() && root.cur() >= 0;
            activated => {
                root.delete-task(root.active-tasks[root.cur()].id);
            }
        }

        // 操作の取り消し・やり直し。入力欄にフォーカスがあるときは入力欄が先に受け取る（文字の取り消し）
        KeyBinding {
            keys: @keys(Control + Z);
            enabled: !root.confirm-open;
            activated => {
                Bridge.undo();
            }
        }

        KeyBinding {
            keys: @keys(Control + Y);
            enabled: !root.confirm-open;
            activated => {
                Bridge.redo();
            }
        }

        KeyBinding {
            keys: @keys(Control + Shift + Z);
            enabled: !root.confirm-open;
            activated => {
                Bridge.redo();
            }
        }

        // タスクのコピー・貼り付け。入力欄にフォーカスがあるときは入力欄が先に受け取る（文字のコピー・貼り付け）
        KeyBinding {
            keys: @keys(Control + C);
            enabled: !root.confirm-open;
            activated => {
                Bridge.copy-task();
            }
        }

        KeyBinding {
            keys: @keys(Control + V);
            enabled: !root.confirm-open;
            activated => {
                Bridge.paste-task();
            }
        }

        // ブラウザと同じ Alt+← / Alt+→ でも戻る・進む（マウスの戻る・進むボタンは Rust 側で拾う）
        KeyBinding {
            keys: @keys(Alt + LeftArrow);
            activated => {
                Bridge.nav-back();
            }
        }

        KeyBinding {
            keys: @keys(Alt + RightArrow);
            activated => {
                Bridge.nav-forward();
            }
        }

        VerticalLayout {
            if root.compact: Rectangle {
                height: 44px;
                background: Theme.panel;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 8px;
                    TextButton {
                        text: "メニュー";
                        bordered: true;
                        mono: false;
                        clicked => {
                            root.drawer-open = true;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    TextButton {
                        text: "検索";
                        bordered: true;
                        mono: false;
                        clicked => {
                            root.open-search();
                        }
                    }

                    TextButton {
                        text: root.overdue-count > 0 ? "通知 " + root.overdue-count : "通知";
                        bordered: true;
                        mono: false;
                        text-color: root.overdue-count > 0 ? Theme.high : Theme.mute;
                        clicked => {
                            root.notif-open = true;
                        }
                    }
                }
            }

            HorizontalLayout {
                if !root.compact: Sidebar {
                    width: root.sidebar-open ? 220px : 60px;
                    open: root.sidebar-open;
                    view: root.view;
                    project-id: root.project-id;
                    projects: root.projects;
                    overdue-count: root.overdue-count;
                    navigate(v, p) => {
                        root.navigate(v, p);
                    }
                    command => {
                        root.open-palette();
                    }
                    toggle-open => {
                        root.sidebar-open = !root.sidebar-open;
                    }
                    add-project(name) => {
                        root.add-project(name);
                    }
                    search => {
                        root.open-search();
                    }
                    notif => {
                        root.notif-open = true;
                    }
                    move-project(payload, before) => {
                        root.move-project(payload, before);
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;

                    if root.view == "today" && root.today-chart: TimeChart {
                    rows: root.plan-rows;
                    unplaced-count: root.plan-unplaced-count;
                    slots: root.chart-slots;
                    start-hour: root.chart-start-hour;
                    now-slot: root.chart-now-slot;
                    compact: root.compact;
                    place(id, slot) => { root.plan-place(id, slot); }
                    place-now(id) => { root.plan-place-now(id); }
                    arrange => { root.plan-arrange(); }
                    open(id) => { root.open-task(id); }
                    toggle(id) => { root.toggle-task(id); }
                    resize(id, n) => { root.plan-resize(id, n); }
                    move-by(id, d) => { root.plan-move-by(id, d); }
                    resize-by(id, d) => { root.plan-resize-by(id, d); }
                    remove(id) => { root.plan-remove(id); }
                    actual-stop(id) => { root.actual-stop(id); }
                    actual-set(id, s, e) => { root.actual-set(id, s, e); }
                    show-list => { root.today-chart = false; }
                }

                if (root.view == "today" && !root.today-chart) || root.view == "project": TaskTable {
                    show-chart => { root.today-chart = true; }
                        compact: root.compact;
                    cursor: root.cur();
                    compose-request <=> root.compose-request;
                    leave-composer => {
                        root.list-cursor = max(0, root.list-cursor);
                        keys.focus();
                    }
                    hint-dismissed <=> root.hint-dismissed;
                    dismiss-hint => { root.dismiss-hint(); }
                        title: root.list-title;
                        subtitle: root.list-subtitle;
                        active: root.active-tasks;
                        done: root.done-tasks;
                        archive-open <=> root.archive-open;
                        sortable: root.view == "today";
                        sort-index <=> root.today-sort;
                        sort-changed => { root.sort-changed(); }
                        add-task(t) => { root.add-task(t); }
                        open(id) => { root.open-task(id); }
                        toggle(id) => { root.toggle-task(id); }
                        toggle-expanded(id) => { root.toggle-expanded(id); }
                        set-priority(id, p) => { root.set-priority(id, p); }
                        set-due(id, y, m, d) => { root.set-due(id, y, m, d); }
                        clear-due(id) => { root.clear-due(id); }
                        duplicate(id) => { root.duplicate-task(id); }
                        delete(id) => { root.delete-task(id); }
                        toggle-subtask(tid, sid) => { root.toggle-subtask(tid, sid); }
                    }

                    if root.view == "settings": SettingsPage {
                        dark: Theme.dark;
                        data-path: root.data-path;
                        set-dark(d) => {
                            root.set-dark(d);
                            Palette.color-scheme = d ? ColorScheme.dark : ColorScheme.light;
                        }
                        export-json => { root.export-json(); }
                        import-json => { root.import-json(); }
                        day-start-hour: root.day-start-hour;
                    day-end-hour: root.day-end-hour;
                    set-day-range(s, e) => { root.set-day-range(s, e); }
                    latest-backup: root.latest-backup;
                        restore-backup => { root.restore-backup(); }
                        open-backups => { root.open-backups(); }
                        reset => { root.reset-data(); }
                    }

                    if root.view == "upcoming": UpcomingView {
                    move-task(payload, column) => { root.move-task-to-column(payload, column); }
                        columns: root.columns;
                        open(id) => { root.open-task(id); }
                        toggle(id) => { root.toggle-task(id); }
                        toggle-expanded(id) => { root.toggle-expanded(id); }
                        toggle-subtask(tid, sid) => { root.toggle-subtask(tid, sid); }
                    }

                    if root.view == "calendar": CalendarView {
                    compact: root.compact;
                        title: root.cal-title;
                        monday-first: root.cal-monday-first;
                        cells: root.cal-cells;
                        shift(d) => { root.cal-shift(d); }
                        go-today => { root.cal-today(); }
                        open-day(y, m, d) => { root.open-day(y, m, d); }
                        open(id) => { root.open-task(id); }
                    }

                    if root.view == "projects": ProjectsView {
                        columns: root.columns;
                        open(id) => { root.open-task(id); }
                        open-project(id) => { root.navigate("project", id); }
                        add-project(name, color) => { root.add-project-color(name, color); }
                        update-project(id, name, color) => { root.update-project(id, name, color); }
                        delete-project(id) => { root.delete-project(id); }
                        move-project(payload, before) => { root.move-project(payload, before); }
                    }

                    if root.view == "review": ReviewView {
                        compact: root.compact;
                        period: root.review-period;
                        unit: root.review-unit;
                        now-label: root.review-now-label;
                        at-now: root.review-at-now;
                        summary: root.review-summary;
                        groups: root.review-groups;
                        set-unit(i) => { root.review-set-unit(i); }
                        shift(d) => { root.review-shift(d); }
                        go-now => { root.review-now(); }
                        copy => { root.review-copy(); }
                        export-csv => { root.review-export(); }
                        open(id) => { root.open-task(id); }
                    }

                    if root.view == "tags": TagsView {
                        columns: root.columns;
                        open(id) => { root.open-task(id); }
                        add-tag(name) => { root.add-tag(name); }
                        delete-tag(id) => { root.delete-tag(id); }
                    }

                    // 元アプリと同じく、カレンダーの範囲だけを覆う
                    if root.view == "calendar" && root.day-open: DayDialog {
                        title: root.day-title;
                        tasks: root.day-tasks;
                        close => { root.day-open = false; }
                        open(id) => {
                            root.day-open = false;
                            root.open-task(id);
                        }
                    }
                }
            }
        }

        // mini モードのサイドバー（ドロワー）
        if root.compact && root.drawer-open: Rectangle {
            background: #00000066;
            TouchArea {
                clicked => {
                    root.drawer-open = false;
                }
            }

            TouchArea {
                x: 0px;
                width: 220px;
            }

            Sidebar {
                x: 0px;
                width: 220px;
                height: root.height;
                open: true;
                view: root.view;
                project-id: root.project-id;
                projects: root.projects;
                overdue-count: root.overdue-count;
                navigate(v, p) => {
                    root.drawer-open = false;
                    root.navigate(v, p);
                }
                command => {
                    root.drawer-open = false;
                    root.open-palette();
                }
                toggle-open => {
                    root.sidebar-open = !root.sidebar-open;
                }
                add-project(name) => {
                    root.add-project(name);
                }
                search => {
                    root.drawer-open = false;
                    root.open-search();
                }
                notif => {
                    root.drawer-open = false;
                    root.notif-open = true;
                }
                move-project(payload, before) => {
                    root.move-project(payload, before);
                }
            }

        }

        if root.detail-open: TaskDetail {
            data: root.detail;
            following <=> root.series-following;
            subtasks: root.detail-subtasks;
            tags: root.detail-tags;
            project-options: root.project-options;
            close => { root.close-overlays(); }
            update-title(id, t) => { root.update-title(id, t); }
            update-notes(id, n) => { root.update-notes(id, n); }
            toggle-status(id) => { root.toggle-status(id); }
            set-priority(id, p) => { root.set-priority(id, p); }
            set-due(id, y, m, d) => { root.set-due(id, y, m, d); }
            set-due-in(id, days) => { root.set-due-in(id, days); }
            clear-due(id) => { root.clear-due(id); }
            set-project(id, i) => { root.set-project(id, i); }
            set-repeating(id, on) => { root.set-repeating(id, on); }
            set-interval(id, i) => { root.set-interval(id, i); }
            set-recurrence-end(id, y, m, d) => { root.set-recurrence-end(id, y, m, d); }
            clear-recurrence-end(id) => { root.clear-recurrence-end(id); }
            toggle-tag(id, tag) => { root.toggle-tag(id, tag); }
            add-subtask(id, t) => { root.add-subtask(id, t); }
            toggle-subtask(id, s) => { root.toggle-subtask(id, s); }
            delete-subtask(id, s) => { root.delete-subtask(id, s); }
            rename-subtask(id, s, t) => { root.rename-subtask(id, s, t); }
            draft-title(id, t) => { root.draft-title(id, t); }
            draft-notes(id, n) => { root.draft-notes(id, n); }
            draft-subtask(id, s, t) => { root.draft-subtask(id, s, t); }
            commit-drafts => { root.commit-drafts(); }
            drop-subtask(id, s, slot) => { root.drop-subtask(id, s, slot); }
            duplicate(id) => { root.duplicate-task(id); }
            delete(id) => { root.delete-task(id); }
        }

        if root.palette-open: palette := CommandPalette {
            items: root.commands;
            index <=> root.palette-index;
            init => {
                self.focus-input();
            }
            query-changed(q) => { root.palette-query(q); }
            run(i) => {
                root.palette-run(i);
                root.close-overlays();
            }
            close => { root.close-overlays(); }
        }

        if root.search-open: SearchPanel {
            results: root.search-results;
            has-query: root.search-has-query;
            init => {
                self.focus-input();
            }
            query-changed(q) => { root.search-query(q); }
            open(id) => {
                root.close-overlays();
                root.open-task(id);
            }
            close => { root.close-overlays(); }
        }

        if root.notif-open: NotifPanel {
            overdue: root.notif-overdue;
            today: root.notif-today;
            open(id) => {
                root.close-overlays();
                root.open-task(id);
            }
            close => { root.close-overlays(); }
        }

        // 詳細パネルの上にも出せるよう最後に置く
        if root.confirm-open: ConfirmDialog {
            message: root.confirm-message;
            ok-label: root.confirm-ok-label;
            answered(ok) => {
                root.confirm-open = false;
                root.confirm-result(ok);
                keys.focus();
            }
        }

        // トースト。詳細パネルが開いているときはその左側、閉じているときは本文の中央下に出す
        if root.toast-text != "": toast := Rectangle {
            property <length> area-left: root.detail-open || root.compact ? 0px : (root.sidebar-open ? 220px : 60px);
            property <length> area-right: root.detail-open ? root.width - 480px : root.width;

            width: min(toast-layout.preferred-width, min(520px, self.area-right - self.area-left - 32px));
            height: toast-layout.preferred-height;
            x: self.area-left + (self.area-right - self.area-left - self.width) / 2;
            y: root.height - self.height - 24px;
            border-radius: 6px;
            background: root.toast-error ? Theme.high : Theme.ink;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;

            TouchArea { }

            toast-layout := HorizontalLayout {
                padding-left: 14px;
                padding-right: root.toast-action != "" ? 6px : 14px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 12px;
                Label {
                    horizontal-stretch: 1;
                    text: root.toast-text;
                    text-color: Theme.bg;
                    font-size: Theme.fs-xs;
                    line-height: 24px;
                }

                if root.toast-action != "": TextButton {
                    text: root.toast-action;
                    mono: false;
                    font-size: Theme.fs-xs;
                    font-weight: 600;
                    text-color: Theme.bg;
                    hover-color: Theme.bg;
                    underline-on-hover: true;
                    pad-x: 8px;
                    line-height: 24px;
                    clicked => {
                        root.toast-action-clicked();
                    }
                }
            }
        }
    }
}
