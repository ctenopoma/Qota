// 未移植だった画面: 今後（カンバン）・カレンダー・プロジェクト一覧・タグ・検索パネル・通知パネル
// 旧 Tauri 版の src/pages/{Upcoming,Calendar,ProjectsList,Tags}.tsx / src/components/{SearchPanel,NotifPanel}.tsx の移植（時間計測の表示は外した）
import { ScrollView } from "std-widgets.slint";
import { Theme, Bridge } from "theme.slint";
import { Check, Label, TextButton, Input, HLine } from "widgets.slint";
import { TaskItem, Column, CalCell } from "types.slint";

// ───── 共通の部品 ─────

component Header inherits HorizontalLayout {
    in property <string> title;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
    spacing: 16px;
    Label {
        text: root.title;
        font-size: Theme.fs-base;
        font-weight: 600;
    }

    @children
}

component Dot inherits Rectangle {
    in property <color> dot-color;
    in property <length> size: 6px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.dot-color;
}

// プロジェクト名のバッジ（色の点つき）
component ProjectBadge inherits Rectangle {
    in property <string> name;
    in property <color> dot-color;
    horizontal-stretch: 0;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 1px;
        padding-bottom: 1px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            Dot {
                dot-color: root.dot-color;
            }
        }

        Label {
            text: root.name;
            text-color: Theme.mute;
            font-size: Theme.fs-2xs;
            mono: true;
        }
    }
}

// 今後のカード: チェック・タイトル・サブタスクの開閉・プロジェクト・期日
component UpcomingCard inherits Rectangle {
    in property <TaskItem> task;
    callback open(id: string);
    callback toggle(id: string);
    callback toggle-expanded(id: string);
    callback toggle-subtask(task-id: string, subtask-id: string);

    background: Theme.bg;
    border-radius: 4px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.mute : Theme.border;
    clip: true;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open(root.task.id);
        }

        VerticalLayout {
            VerticalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Check {
                            checked: root.task.done;
                            toggled => {
                                root.toggle(root.task.id);
                            }
                        }
                    }

                    Label {
                        horizontal-stretch: 1;
                        text: root.task.title;
                        strike: root.task.done;
                        text-color: root.task.done ? Theme.mute : Theme.ink;
                    }

                    if root.task.sub-total > 0: TextButton {
                        text: (root.task.expanded ? "▼ " : "▶ ") + root.task.sub-done + "/" + root.task.sub-total;
                        family: Theme.symbol;
                        text-color: Theme.faint;
                        clicked => {
                            root.toggle-expanded(root.task.id);
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    if root.task.project-name != "": ProjectBadge {
                        name: root.task.project-name;
                        dot-color: root.task.project-color;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    if root.task.due-label != "": Label {
                        text: root.task.due-label;
                        text-color: Theme.faint;
                        font-size: Theme.fs-2xs;
                        mono: true;
                    }
                }
            }

            if root.task.expanded && root.task.sub-total > 0: Rectangle {
                background: Theme.panel.with-alpha(0.5);
                HLine {
                    y: 0;
                }

                VerticalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    for s in root.task.subtasks: HorizontalLayout {
                        spacing: 6px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        VerticalLayout {
                            alignment: center;
                            Check {
                                size: 12px;
                                checked: s.done;
                                toggled => {
                                    root.toggle-subtask(root.task.id, s.id);
                                }
                            }
                        }

                        Label {
                            horizontal-stretch: 1;
                            text: s.title;
                            strike: s.done;
                            text-color: s.done ? Theme.mute : Theme.faint;
                            font-size: Theme.fs-xs;
                        }
                    }
                }
            }
        }
    }
}

// プロジェクト一覧・タグのカード: タイトル・優先度・期日・サブタスクの数
component PlainCard inherits Rectangle {
    in property <TaskItem> task;
    callback open(id: string);

    background: Theme.bg;
    border-radius: 4px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.high : Theme.border;
    drop-shadow-blur: 2px;
    drop-shadow-color: #0000001a;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open(root.task.id);
        }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Label {
                    horizontal-stretch: 1;
                    text: root.task.title;
                    strike: root.task.done;
                    text-color: root.task.done ? Theme.mute : Theme.ink;
                }

                if root.task.priority != 0: Label {
                    text: Theme.priority-label(root.task.priority);
                    text-color: Theme.priority-color(root.task.priority);
                    font-size: Theme.fs-2xs;
                    font-weight: 700;
                    mono: true;
                }
            }

            HorizontalLayout {
                Label {
                    horizontal-stretch: 1;
                    text: root.task.due-label;
                    text-color: Theme.faint;
                    font-size: Theme.fs-2xs;
                    mono: true;
                }

                if root.task.sub-total > 0: Label {
                    text: "⌘ " + root.task.sub-done + "/" + root.task.sub-total;
                    family: Theme.symbol;
                    text-color: Theme.faint;
                    font-size: Theme.fs-2xs;
                }
            }
        }
    }
}

// 列の枠。中身（カード）は呼び出し側が @children で入れる
component ColumnFrame inherits Rectangle {
    in property <length> column-width: 280px;
    width: root.column-width;
    background: Theme.panel;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    VerticalLayout {
        @children
    }
}

// 列の中の縦スクロール
component ColumnBody inherits ScrollView {
    in property <length> gap: 4px;
    in property <length> pad: 8px;
    vertical-stretch: 1;
    content-width: self.visible-width;
    content-height: max(self.visible-height, body.preferred-height);
    body := VerticalLayout {
        width: root.visible-width;
        alignment: start;
        padding: root.pad;
        spacing: root.gap;
        @children
    }
}

component EmptyNote inherits Label {
    in property <string> note: "なし";
    text: root.note;
    text-color: Theme.faint;
    font-size: Theme.fs-2xs;
    mono: true;
    align: center;
    line-height: 48px;
}

// プロジェクトの色（元アプリの PROJECT_COLORS）
component Swatches inherits HorizontalLayout {
    in-out property <string> selected;
    spacing: 8px;
    alignment: start;
    for c in [
        { key: "#ef4444", c: #ef4444 },
        { key: "#f97316", c: #f97316 },
        { key: "#eab308", c: #eab308 },
        { key: "#22c55e", c: #22c55e },
        { key: "#06b6d4", c: #06b6d4 },
        { key: "#3b82f6", c: #3b82f6 },
        { key: "#8b5cf6", c: #8b5cf6 },
        { key: "#ec4899", c: #ec4899 },
    ]: Rectangle {
        width: 22px;
        height: 22px;
        Rectangle {
            property <bool> on: root.selected == c.key;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: self.on ? 22px : 18px;
            height: self.width;
            border-radius: self.width / 2;
            background: c.c;
            border-width: self.on ? 2px : 0px;
            border-color: Theme.ink;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.selected = c.key;
            }
        }
    }
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked();
    border-radius: 4px;
    background: root.primary ? Theme.accent : transparent;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 4px;
        padding-bottom: 4px;
        Label {
            text: root.text;
            text-color: root.primary ? Theme.bg : (ta.has-hover ? Theme.ink : Theme.faint);
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// 横スクロールで列を並べる。列の中身は呼び出し側が @children で入れる
component Board inherits Rectangle {
    in property <int> count;
    in property <length> column-width: 280px;
    in property <length> gap: 12px;
    in property <length> pad: 16px;
    vertical-stretch: 1;
    // 列が画面に収まらないときだけ、下に横スクロールバーを出す
    // （標準の ScrollView のバーは 2px の線で、ホバーするまでほぼ見えない）
    property <length> total-width: root.count * (root.column-width + root.gap) - root.gap + 2 * root.pad;
    property <bool> overflow: root.total-width > root.width + 1px;
    property <length> bar-area: root.overflow ? 20px : 0px;
    property <length> max-scroll: sv.content-width - sv.visible-width;

    function scroll-to(x: length) {
        sv.content-x = max(-root.max-scroll, min(0px, x));
    }

    // ScrollView が横に動くのは Shift+ホイールと横ホイールだけなので、
    // 列が縦にスクロールしなかった縦ホイールをここで受けて横へ回す
    TouchArea {
        y: 0;
        height: root.height - root.bar-area;
        scroll-event(event) => {
            if event.delta-y != 0 && event.delta-x == 0 && !event.modifiers.shift {
                root.scroll-to(sv.content-x + event.delta-y);
                return accept;
            }
            reject
        }
        sv := ScrollView {
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: max(self.visible-width, root.total-width);
            content-height: self.visible-height;
            HorizontalLayout {
                height: sv.visible-height;
                padding: root.pad;
                padding-bottom: root.overflow ? 8px : root.pad;
                spacing: root.gap;
                alignment: start;
                @children
            }
        }
    }

    if root.overflow: track := Rectangle {
        x: root.pad;
        y: root.height - 16px;
        width: root.width - 2 * root.pad;
        height: 8px;
        border-radius: 4px;
        background: Theme.panel2;
        property <length> thumb-width: max(40px, self.width * sv.visible-width / sv.content-width);
        property <length> travel: self.width - self.thumb-width;
        property <length> grab-offset;

        Rectangle {
            x: root.max-scroll > 0 ? track.travel * (-sv.content-x / root.max-scroll) : 0;
            width: track.thumb-width;
            border-radius: 4px;
            background: bar-touch.pressed || bar-touch.has-hover ? Theme.mute : Theme.faint;
        }

        bar-touch := TouchArea {
            // 上下に少し広げて、細いバーでもつかみやすくする
            y: -6px;
            height: parent.height + 12px;
            mouse-cursor: default;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    // つまみの上なら掴んだ位置を保つ。溝なら、つまみの中央をそこへ移す
                    let thumb-x = root.max-scroll > 0 ? track.travel * (-sv.content-x / root.max-scroll) : 0;
                    track.grab-offset = self.mouse-x >= thumb-x && self.mouse-x <= thumb-x + track.thumb-width
                        ? self.mouse-x - thumb-x : track.thumb-width / 2;
                    self.follow();
                }
            }
            moved => {
                if self.pressed {
                    self.follow();
                }
            }
            function follow() {
                if track.travel > 0 {
                    root.scroll-to(-(self.mouse-x - track.grab-offset) / track.travel * root.max-scroll);
                }
            }
            scroll-event(event) => {
                if event.delta-y != 0 || event.delta-x != 0 {
                    root.scroll-to(sv.content-x + (event.delta-x != 0 ? event.delta-x : event.delta-y));
                    return accept;
                }
                reject
            }
        }
    }
}

// ───── 今後（カンバン）─────

export component UpcomingView inherits Rectangle {
    in property <[Column]> columns;
    callback open(id: string);
    callback toggle(id: string);
    callback toggle-expanded(id: string);
    callback toggle-subtask(task-id: string, subtask-id: string);

    VerticalLayout {
        Header {
            title: "今後";
        }

        HLine { }

        Board {
            count: root.columns.length;
            for col in root.columns: ColumnFrame {
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    Label {
                        horizontal-stretch: 1;
                        text: col.title;
                        font-size: Theme.fs-2xs;
                        mono: true;
                        letter-spacing: 1.1px;
                    }

                    Label {
                        text: col.sub;
                        text-color: Theme.faint;
                        font-size: Theme.fs-2xs;
                        mono: true;
                    }
                }

                HLine { }

                ColumnBody {
                    if col.tasks.length == 0: EmptyNote { }
                    for t in col.tasks: UpcomingCard {
                        task: t;
                        open(id) => { root.open(id); }
                        toggle(id) => { root.toggle(id); }
                        toggle-expanded(id) => { root.toggle-expanded(id); }
                        toggle-subtask(tid, sid) => { root.toggle-subtask(tid, sid); }
                    }
                }
            }
        }
    }
}

// ───── プロジェクト一覧 ─────

export component ProjectsView inherits Rectangle {
    in property <[Column]> columns;
    callback open(id: string);
    callback open-project(id: string);
    callback add-project(name: string, color: string);
    callback update-project(id: string, name: string, color: string);
    callback delete-project(id: string);

    property <string> new-color: "#ef4444";
    property <string> editing-id;
    property <string> edit-color;
    property <string> edit-name;

    VerticalLayout {
        Header {
            title: "プロジェクト";
        }

        HLine { }

        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 12px;
            padding-bottom: 12px;
            spacing: 8px;
            Swatches {
                selected <=> root.new-color;
            }

            Input {
                vertical-stretch: 0;
                placeholder: "+ 新しいプロジェクト";
                accepted(text) => {
                    root.add-project(text, root.new-color);
                    self.text = "";
                    root.new-color = "#ef4444";
                }
            }
        }

        HLine { }

        Board {
            count: root.columns.length;
            column-width: 288px;
            gap: 24px;
            pad: 24px;
            for col in root.columns: ColumnFrame {
                column-width: 288px;
                if root.editing-id == col.id: VerticalLayout {
                    // 列の残りの高さはタスクの一覧に回す（伸ばすと入力欄とボタンが縦に大きくなる）
                    vertical-stretch: 0;
                    padding: 12px;
                    spacing: 8px;
                    Swatches {
                        selected <=> root.edit-color;
                    }

                    Input {
                        bordered: true;
                        text: col.title;
                        init => {
                            self.focus();
                        }
                        edited(text) => {
                            root.edit-name = text;
                        }
                        accepted(text) => {
                            root.update-project(col.id, text, root.edit-color);
                            root.editing-id = "";
                        }
                    }

                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        SmallButton {
                            text: "キャンセル";
                            clicked => {
                                root.editing-id = "";
                            }
                        }

                        SmallButton {
                            text: "保存";
                            primary: true;
                            clicked => {
                                root.update-project(col.id, root.edit-name, root.edit-color);
                                root.editing-id = "";
                            }
                        }
                    }
                }

                if root.editing-id != col.id: HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 8px;
                    title-ta := TouchArea {
                        horizontal-stretch: 1;
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-project(col.id);
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Dot {
                                    size: 8px;
                                    dot-color: col.color;
                                }
                            }

                            Label {
                                text: col.title;
                                font-weight: 600;
                                mono: true;
                                underline: title-ta.has-hover;
                            }
                        }
                    }

                    Label {
                        text: col.sub;
                        text-color: Theme.faint;
                        font-size: Theme.fs-2xs;
                        mono: true;
                    }

                    TextButton {
                        text: "✎";
                        family: Theme.symbol;
                        font-size: Theme.fs-sm;
                        text-color: Theme.faint;
                        clicked => {
                            root.edit-name = col.title;
                            root.edit-color = col.color-key;
                            root.editing-id = col.id;
                        }
                    }

                    TextButton {
                        text: "×";
                        font-size: Theme.fs-sm;
                        text-color: Theme.faint;
                        hover-color: Theme.high;
                        clicked => {
                            root.delete-project(col.id);
                        }
                    }
                }

                ColumnBody {
                    gap: 8px;
                    if col.tasks.length == 0: EmptyNote {
                        note: "未完了のタスクなし";
                    }
                    for t in col.tasks: PlainCard {
                        task: t;
                        open(id) => { root.open(id); }
                    }
                }
            }
        }
    }
}

// ───── タグ ─────

export component TagsView inherits Rectangle {
    in property <[Column]> columns;
    callback open(id: string);
    callback add-tag(name: string);
    callback delete-tag(id: string);

    VerticalLayout {
        Header {
            title: "タグ";
        }

        HLine { }

        HorizontalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 8px;
            padding-bottom: 8px;
            Input {
                placeholder: "+ 新しいタグ";
                accepted(text) => {
                    root.add-tag(text);
                    self.text = "";
                }
            }
        }

        HLine { }

        Board {
            count: root.columns.length;
            column-width: 288px;
            gap: 24px;
            pad: 24px;
            for col in root.columns: ColumnFrame {
                column-width: 288px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 8px;
                    Label {
                        horizontal-stretch: 1;
                        text: col.title;
                        font-weight: 600;
                        mono: true;
                    }

                    Label {
                        text: col.sub;
                        text-color: Theme.faint;
                        font-size: Theme.fs-2xs;
                        mono: true;
                    }

                    TextButton {
                        text: "×";
                        font-size: Theme.fs-sm;
                        text-color: Theme.faint;
                        hover-color: Theme.high;
                        clicked => {
                            root.delete-tag(col.id);
                        }
                    }
                }

                ColumnBody {
                    gap: 8px;
                    if col.tasks.length == 0: EmptyNote {
                        note: "タスクなし";
                    }
                    for t in col.tasks: PlainCard {
                        task: t;
                        open(id) => { root.open(id); }
                    }
                }
            }
        }
    }
}

// ───── カレンダー ─────

// カレンダーのマスや一覧に出すタスク（色の点・取り消し線つき）
component TaskChip inherits Rectangle {
    in property <TaskItem> task;
    in property <bool> large;
    callback open(id: string);

    border-radius: 4px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.mute : Theme.border;
    background: Theme.panel;
    opacity: root.task.done ? 0.5 : 1;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open(root.task.id);
        }
        HorizontalLayout {
            padding-left: root.large ? 12px : 6px;
            padding-right: root.large ? 12px : 6px;
            padding-top: root.large ? 8px : 2px;
            padding-bottom: root.large ? 8px : 2px;
            spacing: root.large ? 8px : 4px;
            if root.task.project-name != "": VerticalLayout {
                alignment: center;
                Dot {
                    size: root.large ? 8px : 6px;
                    dot-color: root.task.project-color;
                }
            }
            Label {
                horizontal-stretch: 1;
                text: root.task.title;
                strike: root.task.done;
                text-color: root.task.done ? Theme.mute : Theme.ink;
                font-size: root.large ? Theme.fs-sm : Theme.fs-2xs;
            }
        }
    }
}

export component CalendarView inherits Rectangle {
    in property <string> title;
    in property <bool> monday-first;
    in property <[CalCell]> cells;
    callback shift(delta: int);
    callback go-today();
    callback open-day(year: int, month: int, day: int);
    callback open(id: string);

    VerticalLayout {
        Header {
            title: root.title;
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                TextButton {
                    text: "◀";
                    family: Theme.symbol;
                    font-size: Theme.fs-sm;
                    pad-x: 6px;
                    clicked => {
                        root.shift(-1);
                    }
                }

                TextButton {
                    text: "▶";
                    family: Theme.symbol;
                    font-size: Theme.fs-sm;
                    pad-x: 6px;
                    clicked => {
                        root.shift(1);
                    }
                }

                Rectangle {
                    width: 8px;
                }

                TextButton {
                    text: "今日";
                    pad-x: 8px;
                    clicked => {
                        root.go-today();
                    }
                }
            }
        }

        HLine { }

        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            HorizontalLayout {
                for w in (root.monday-first ? ["月", "火", "水", "木", "金", "土", "日"] : ["日", "月", "火", "水", "木", "金", "土"]): Label {
                    horizontal-stretch: 1;
                    text: w;
                    text-color: Theme.faint;
                    font-size: Theme.fs-2xs;
                    mono: true;
                    align: center;
                    line-height: 24px;
                }
            }

            grid := Rectangle {
                property <int> rows: ceil(root.cells.length / 7);
                property <length> cell-w: (self.width - 1px) / 7;
                property <length> cell-h: max(80px, (self.height - 1px) / max(1, self.rows));
                vertical-stretch: 1;
                background: Theme.border;
                clip: true;

                for c[i] in root.cells: Rectangle {
                    x: 1px + mod(i, 7) * grid.cell-w;
                    y: 1px + floor(i / 7) * grid.cell-h;
                    width: grid.cell-w - 1px;
                    height: grid.cell-h - 1px;
                    background: Theme.bg;

                    if c.day > 0: cell-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-day(c.year, c.month, c.day);
                        }
                        Rectangle {
                            background: cell-ta.has-hover ? Theme.panel.with-alpha(0.3) : transparent;
                        }

                        VerticalLayout {
                            padding: 4px;
                            spacing: 4px;
                            alignment: start;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    border-radius: 12px;
                                    background: c.today ? Theme.accent : transparent;
                                    Label {
                                        width: 100%;
                                        height: 100%;
                                        text: c.day;
                                        text-color: c.today ? Theme.bg : Theme.ink;
                                        font-size: Theme.fs-2xs;
                                        mono: true;
                                        align: center;
                                    }
                                }
                            }

                            for t in c.tasks: TaskChip {
                                task: t;
                                open(id) => { root.open(id); }
                            }
                            if c.more > 0: Label {
                                text: "+ " + c.more + " 件";
                                text-color: Theme.mute;
                                font-size: Theme.fs-2xs;
                                font-weight: 600;
                                align: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

// 日付を押したときの、その日のタスクの一覧（元アプリは backdrop-blur。Slint には無いので半透明で代用）
export component DayDialog inherits Rectangle {
    in property <string> title;
    in property <[TaskItem]> tasks;
    callback close();
    callback open(id: string);

    background: Theme.bg.with-alpha(0.6);
    TouchArea {
        clicked => {
            root.close();
        }
    }

    box := Rectangle {
        x: (root.width - self.width) / 2;
        y: max(16px, (root.height - self.height) / 2);
        width: min(384px, root.width - 32px);
        height: min(box-layout.preferred-height, root.height * 0.8);
        background: Theme.bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000066;
        clip: true;

        TouchArea { }

        box-layout := VerticalLayout {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 12px;
                padding-bottom: 12px;
                Label {
                    horizontal-stretch: 1;
                    text: root.title;
                    font-weight: 600;
                }

                TextButton {
                    text: "✕";
                    family: Theme.symbol;
                    font-size: Theme.fs-sm;
                    clicked => {
                        root.close();
                    }
                }
            }

            HLine { }

            ColumnBody {
                pad: 16px;
                gap: 8px;
                // ScrollView の preferred-height は 100% なので、ダイアログの高さが循環しないよう中身から決める
                preferred-height: max(80px, 32px + root.tasks.length * 46px);
                if root.tasks.length == 0: Label {
                    text: "タスクはありません";
                    text-color: Theme.mute;
                    align: center;
                    line-height: 48px;
                }
                for t in root.tasks: TaskChip {
                    task: t;
                    large: true;
                    open(id) => { root.open(id); }
                }
            }
        }
    }
}

// ───── 検索パネル（Ctrl+/）─────

export component SearchPanel inherits Rectangle {
    in property <[TaskItem]> results;
    in property <bool> has-query;
    callback query-changed(q: string);
    callback open(id: string);
    callback close();

    public function focus-input() {
        input.focus();
    }

    background: #00000066;
    TouchArea {
        clicked => {
            root.close();
        }
    }

    box := Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height * 0.15;
        width: min(560px, root.width - 32px);
        height: box-layout.preferred-height;
        background: Theme.panel;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #00000080;
        clip: true;

        TouchArea { }

        box-layout := VerticalLayout {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                input := Input {
                    placeholder: "タスクを全文検索…";
                    edited(text) => {
                        root.query-changed(text);
                    }
                }
            }

            HLine { }

            if !root.has-query: EmptyNote {
                note: "検索キーワードを入力";
                line-height: 80px;
            }
            if root.has-query && root.results.length == 0: EmptyNote {
                note: "一致するタスクなし";
                line-height: 80px;
            }
            if root.results.length > 0: rsv := ScrollView {
                height: min(384px, list.preferred-height);
                content-width: self.visible-width;
                content-height: list.preferred-height;
                list := VerticalLayout {
                    width: rsv.visible-width;
                    for t in root.results: rta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open(t.id);
                        }
                        Rectangle {
                            background: rta.has-hover ? Theme.panel2 : transparent;
                        }

                        VerticalLayout {
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 8px;
                                Label {
                                    horizontal-stretch: 1;
                                    text: t.title;
                                    strike: t.done;
                                    text-color: t.done ? Theme.mute : Theme.ink;
                                }

                                Label {
                                    text: t.due-label;
                                    text-color: Theme.faint;
                                    font-size: Theme.fs-2xs;
                                    mono: true;
                                }
                            }

                            HLine { }
                        }
                    }
                }
            }
        }
    }
}

// ───── 通知パネル（サイドバーの「!」）─────

component NotifSection inherits VerticalLayout {
    in property <string> title;
    in property <[TaskItem]> items;
    in property <bool> alert;
    callback open(id: string);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 6px;
        padding-bottom: 6px;
        Label {
            text: root.title + " (" + root.items.length + ")";
            text-color: Theme.faint;
            font-size: Theme.fs-2xs;
            mono: true;
            letter-spacing: 1.1px;
        }
    }

    HLine { }

    if root.items.length == 0: HorizontalLayout {
        padding-left: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        Label {
            text: "なし";
            text-color: Theme.faint;
            font-size: Theme.fs-2xs;
        }
    }

    for t in root.items: nta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open(t.id);
        }
        Rectangle {
            background: nta.has-hover ? Theme.panel2 : transparent;
        }

        VerticalLayout {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                Label {
                    text: t.title;
                    text-color: root.alert ? Theme.high : Theme.ink;
                }
            }

            HLine { }
        }
    }
}

export component NotifPanel inherits Rectangle {
    in property <[TaskItem]> overdue;
    in property <[TaskItem]> today;
    callback open(id: string);
    callback close();

    // パネルの外を押したら閉じる
    TouchArea {
        clicked => {
            root.close();
        }
    }

    panel := Rectangle {
        x: root.width - self.width - 12px;
        y: 12px;
        width: 320px;
        height: min(panel-layout.preferred-height, root.height - 24px);
        background: Theme.panel;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #00000080;
        clip: true;

        TouchArea { }

        panel-layout := VerticalLayout {
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 8px;
                Label {
                    horizontal-stretch: 1;
                    text: "通知";
                    font-size: Theme.fs-2xs;
                    mono: true;
                    letter-spacing: 1.1px;
                }

                TextButton {
                    text: "×";
                    text-color: Theme.faint;
                    clicked => {
                        root.close();
                    }
                }
            }

            HLine { }

            NotifSection {
                title: "期限切れ";
                items: root.overdue;
                alert: true;
                open(id) => { root.open(id); }
            }

            NotifSection {
                title: "今日";
                items: root.today;
                open(id) => { root.open(id); }
            }
        }
    }
}
